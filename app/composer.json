{
	"description": "The CodeIgniter framework",
	"name": "codeigniter/framework",
	"type": "project",
	"homepage": "https://codeigniter.com",
	"license": "MIT",
	"support": {
		"forum": "http://forum.codeigniter.com/",
		"wiki": "https://github.com/bcit-ci/CodeIgniter/wiki",
		"slack": "https://codeigniterchat.slack.com",
		"source": "https://github.com/bcit-ci/CodeIgniter"
	},
	"require": {
		"php": "^7.4",
		"firebase/php-jwt": "^6.10",
		"google/apiclient": "^2.16",
		"mpdf/mpdf": "8.2.5",
		"phpoffice/phpspreadsheet": "^1.30.6",
		"psr/http-message": "^1.1",
		"mpdf/psr-http-message-shim": "^1.0"
	},
	"suggest": {
		"paragonie/random_compat": "Provides better randomness in PHP 5.x"
	},
	"scripts": {
		"test:coverage": [
			"@putenv XDEBUG_MODE=coverage",
			"phpunit --color=always --coverage-text --configuration tests/travis/sqlite.phpunit.xml"
		],
		"post-install-cmd": [
			"@php -r \"$p='vendor/mikey179/vfsstream/src/main/php/org/bovigo/vfs/vfsStream.php';if(is_file($p)){file_put_contents($p,str_replace('name{0}','name[0]',file_get_contents($p)));}\""
		],
		"post-update-cmd": [
			"@php -r \"$p='vendor/mikey179/vfsstream/src/main/php/org/bovigo/vfs/vfsStream.php';if(is_file($p)){file_put_contents($p,str_replace('name{0}','name[0]',file_get_contents($p)));}\""
		]
	},
	"require-dev": {
		"mikey179/vfsstream": "1.6.*",
		"phpunit/phpunit": "4.* || 5.* || 9.*"
	}
}
